local function createSkullIcon(parentImageLabel)
	local ok = pcall(function()
		if AssetService and AssetService.CreateEditableImage then
			local editable = AssetService:CreateEditableImage({ Size = Vector2.new(16, 16) })
			local bufferData = {}
			for y = 1, 16 do
				local row = SkullGrid16x16[y]
				for x = 1, 16 do
					local ch = string.sub(row, x, x)
					local col = Palette[ch] or Palette.B
					local idx = ((y - 1) * 16 + (x - 1)) * 4
					bufferData[idx + 1] = math.floor(col.R * 255)
					bufferData[idx + 2] = math.floor(col.G * 255)
					bufferData[idx + 3] = math.floor(col.B * 255)
					bufferData[idx + 4] = 255
				end
			end
			editable:WritePixelsBuffer(Vector2.zero, Vector2.new(16, 16), bufferData)
			parentImageLabel.ImageContent = Content.fromObject(editable)
			return
		end
		error("No EditableImage")
	end)
	if not ok then
		parentImageLabel.Image = ""
		local grid = Instance.new("Frame")
		grid.Size = UDim2.fromScale(1, 1)
		grid.BackgroundColor3 = Palette.B
		grid.BorderSizePixel = 0
		grid.Parent = parentImageLabel

		local uigrid = Instance.new("UIGridLayout")
		uigrid.CellSize = UDim2.fromScale(1 / 16, 1 / 16)
		uigrid.CellPadding = UDim2.fromOffset(0, 0)
		uigrid.SortOrder = Enum.SortOrder.LayoutOrder
		uigrid.Parent = grid

		for y = 1, 16 do
			local row = SkullGrid16x16[y]
			for x = 1, 16 do
				local ch = string.sub(row, x, x)
				local px = Instance.new("Frame")
				px.BorderSizePixel = 0
				px.BackgroundColor3 = Palette[ch] or Palette.B
				px.LayoutOrder = (y - 1) * 16 + x
				px.Parent = grid
			end
		end
	end
end

