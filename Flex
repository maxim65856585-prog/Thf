-- АВТОПОДБОР ОРУЖИЯ (ДИСТАНЦИЯ 2000)
-- ==========================================
local function isDroppedGunPart(part)
	if not part:IsA("BasePart") then return false end
	if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return false end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and part:IsDescendantOf(plr.Character) then
			return false
		end
	end
	local nameLower = string.lower(part.Name)
	local parentName = part.Parent and string.lower(part.Parent.Name) or ""
	if nameLower == "gun" or nameLower == "gundrop" or string.find(nameLower, "gun") or parentName == "gun" or string.find(parentName, "gun") then
		return true
	end
	return false
end

