local flyBV, flyBG

local function updateFlight(dt)
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if not Config.Movement.FlyEnabled or not root or not hum then
		if flyBV then flyBV:Destroy(); flyBV = nil end
		if flyBG then flyBG:Destroy(); flyBG = nil end
		if hum and hum.PlatformStand then
			hum.PlatformStand = false
		end
		return
	end

	hum.PlatformStand = true
	if not flyBV then
		flyBV = Instance.new("BodyVelocity")
		flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		flyBV.Parent = root
	end
	if not flyBG then
		flyBG = Instance.new("BodyGyro")
		flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		flyBG.P = 3000
		flyBG.Parent = root
	end

	local dir = Vector3.zero
	local cf = Camera.CFrame
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

	if dir.Magnitude > 0 then
		dir = dir.Unit * Config.Movement.FlySpeed
	end

	flyBV.Velocity = dir
	flyBG.CFrame = cf
end

local function applyAntiFling()
	if not Config.Movement.AntiFling then return end
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			for _, part in ipairs(plr.Character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
					if part.AssemblyLinearVelocity.Magnitude > 140 or part.AssemblyAngularVelocity.Magnitude > 80 then
						part.AssemblyLinearVelocity = Vector3.zero
						part.AssemblyAngularVelocity = Vector3.zero
					end
				end
			end
		end
	end

	if myRoot then
		if myRoot.AssemblyLinearVelocity.Magnitude > 160 then
			myRoot.AssemblyLinearVelocity = Vector3.zero
		end
		if myRoot.AssemblyAngularVelocity.Magnitude > 90 then
			myRoot.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

-- ==========================================
-- ГЛАВНЫЙ ЦИКЛ ОБНОВЛЕНИЯ
-- ==========================================
local fpsAccumulator = 0
local frameCount = 0
local currentFps = 60

RunService.RenderStepped:Connect(function(dt)
	fpsAccumulator += dt
	frameCount += 1
	if fpsAccumulator >= 0.4 then
		currentFps = math.floor(frameCount / fpsAccumulator + 0.5)
		fpsAccumulator = 0
		frameCount = 0
	end

	local pingMs = 0
	pcall(function()
		pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
	end)
	BadgeInfo.Text = string.format("%s | FPS: %d | Ping: %dms", LocalPlayer.Name, currentFps, pingMs)

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then
		if Config.Movement.SpeedEnabled and not Config.Movement.FlyEnabled then
			hum.WalkSpeed = Config.Movement.WalkSpeed
		elseif not Config.Movement.SpeedEnabled and hum.WalkSpeed == Config.Movement.WalkSpeed then
			hum.WalkSpeed = 16
		end
	end

	updateFlight(dt)
	applyAntiFling()
	processAutoGunPickup()

	for plr, entry in pairs(espObjects) do
		local pChar = plr.Character
		local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
		local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")

		if not Config.ESP.Enabled or not pChar or not pHum or not pRoot or pHum.Health <= 0 then
			hideEspEntry(entry)
		else
			local role = getPlayerRole(plr)
			local col = RoleColors[role] or RoleColors.Innocent

			if Config.ESP.Chams then
				entry.Highlight.Adornee = pChar
				entry.Highlight.FillColor = col
				entry.Highlight.OutlineColor = col
				entry.Highlight.Enabled = true
			else
				entry.Highlight.Enabled = false
			end

			if hasDrawing then
				local rootPos, onScreen = Camera:WorldToViewportPoint(pRoot.Position)
				local topPos = Camera:WorldToViewportPoint(pRoot.Position + Vector3.new(0, 3.1, 0))
				local botPos = Camera:WorldToViewportPoint(pRoot.Position - Vector3.new(0, 3.2, 0))

				if not onScreen then
					entry.Box.Visible = false
					entry.BoxOutline.Visible = false
					entry.HpBack.Visible = false
					entry.HpBar.Visible = false
					entry.Tag.Visible = false
				else
					local height = math.max(math.abs(topPos.Y - botPos.Y), 12)
					local width = height * 0.58
					local boxX = rootPos.X - width / 2
					local boxY = topPos.Y

					if Config.ESP.Boxes then
						entry.BoxOutline.Size = Vector2.new(width, height)
						entry.BoxOutline.Position = Vector2.new(boxX, boxY)
						entry.BoxOutline.Visible = true

						entry.Box.Size = Vector2.new(width, height)
						entry.Box.Position = Vector2.new(boxX, boxY)
						entry.Box.Color = col
						entry.Box.Visible = true
					else
						entry.Box.Visible = false
						entry.BoxOutline.Visible = false
					end

					if Config.ESP.Health then
						local hpRatio = math.clamp(pHum.Health / math.max(pHum.MaxHealth, 1), 0, 1)
						local barX = boxX - 6
						entry.HpBack.From = Vector2.new(barX, boxY)
						entry.HpBack.To = Vector2.new(barX, boxY + height)
						entry.HpBack.Visible = true

						entry.HpBar.From = Vector2.new(barX, boxY + height * (1 - hpRatio))
						entry.HpBar.To = Vector2.new(barX, boxY + height)
						entry.HpBar.Color = Color3.fromRGB(255 * (1 - hpRatio), 255 * hpRatio, 60)
						entry.HpBar.Visible = true
					else
						entry.HpBack.Visible = false
						entry.HpBar.Visible = false
					end

					if Config.ESP.Names then
						local roleRu = (role == "Murderer" and "Убийца") or (role == "Sheriff" and "Шериф") or "Невиновен"
						entry.Tag.Text = string.format("%s [%s]", plr.Name, roleRu)
						entry.Tag.Position = Vector2.new(rootPos.X, boxY - 16)
						entry.Tag.Color = col
						entry.Tag.Visible = true
					else
						entry.Tag.Visible = false
					end
				end
			end
		end
	end

	if fovCircle then
		if Config.Aimbot.Enabled and Config.Aimbot.ShowFOV then
			fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
			fovCircle.Radius = Config.Aimbot.FOV
			fovCircle.Visible = true
		else
			fovCircle.Visible = false
		end
	end

	if Config.Aimbot.Enabled then
		local holdingOk = (not Config.Aimbot.HoldRMB) or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		if holdingOk then
			local targetPart = getBestTarget()
			if targetPart then
				local targetCF = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
				if Config.Aimbot.Smoothness <= 0 then
					Camera.CFrame = targetCF
				else
					Camera.CFrame = Camera.CFrame:Lerp(targetCF, math.clamp(Config.Aimbot.Smoothness, 0.01, 1))
				end
			end
		end
	end
end)
