	local sliding = false
	local function updateFromX(xPos)
		local rel = math.clamp((xPos - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local newVal = math.floor(minVal + (maxVal - minVal) * rel + 0.5)
		val = newVal
		fill.Size = UDim2.fromScale(rel, 1)
		lbl.Text = text .. ": " .. tostring(val)
		if callback then
			callback(val)
		end
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType.Touch then
			sliding = true
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType.Touch) then
			updateFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType.Touch then
			sliding = false
		end
	end)
end

